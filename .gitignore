# ── 绝不能入库的东西 ──────────────────────────────
# 虚拟环境：几百 MB，而且平台相关，别人也装不了
envs/

# 抓下来的行情数据：体积大、每人不同、而且是"可再生"的
lab/data/cache/
lab/report/out/

# 你自己的东西：真实持仓、自选股、交易笔记、策略想法
# 这里放的是真金白银，公开仓库前务必确认它在忽略列表里
overlay/

# 日志
logs/
.tmp/
*.log

# ── Python 常规 ──────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ── 编辑器 / 系统 ──────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── 密钥（万一以后接 API） ──────────────────────
.env
.env.*
*.key
!*.key.example
